# ============================================
# REQUIRED: OpenAI API Key
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
# This is used for:
#   - GPT models (gpt-4, gpt-3.5-turbo, etc.)
#   - Text embeddings (for RAG / knowledge base search)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# REQUIRED: JWT Secret Key
# ============================================
# This is used to secure your login tokens
# Generate a random string with this command:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Or just use any long random string
SECRET_KEY=change-this-to-a-random-string-abc123xyz789

# ============================================
# OPTIONAL: Ollama (Local LLM)
# ============================================
# If you want to use local models (Llama 3.2, Mistral, etc.)
# Install Ollama from: https://ollama.ai
OLLAMA_ENDPOINT=http://localhost:11434

# ============================================
# Frontend API URL (for development)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
